# Chat Provider: "flowise" (recommended) or "openrouter" (demo/experiment)
CHAT_PROVIDER=flowise

# ─── LINE WORKS ───────────────────────────────────────────────
LW_API_20_CLIENT_ID=
LW_API_20_CLIENT_SECRET=
LW_API_20_SERVICE_ACCOUNT_ID=
LW_API_20_PRIVATEKEY=
LW_API_20_BOT_ID=
LW_API_20_BOT_SECRET=

# ─── WeChat Official Account (微信公众平台) ───────────────────
# Token: set in 开发 → 基本配置 → 服务器配置 (plain text mode)
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ─── Flowise (primary) ───────────────────────────────────────
# Full prediction endpoint URL, e.g. https://your-flowise.com/api/v1/prediction/<flow-id>
FLOWISE_API_URL=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT=120

# ─── OpenRouter (demo/experiment) ────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_SYSTEM_PROMPT=You are a helpful assistant.
# Options: high, medium, low, minimal, none
OPENROUTER_REASONING_EFFORT=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ─── Session behaviour (WeChat; optional) ─────────────────────
SESSION_TIMEOUT_MS=600000
SESSION_CLEANUP_INTERVAL_MS=1800000

# ─── App ──────────────────────────────────────────────────────
PORT=8080
DEBUG=false
ENABLE_STATUS_PAGE=false
PUBLIC_BASE_URL=

# Security
MAX_CONTENT_LENGTH=1048576
MAX_MESSAGE_LENGTH=4000
